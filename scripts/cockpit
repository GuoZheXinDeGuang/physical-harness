#!/usr/bin/env bash
# physical-harness cockpit -- the SINGLE native entry for the lab console.
#
# operators run:  scripts/cockpit            (start EVERYTHING; leaves it running)
#                 scripts/cockpit --stop      (stop what THIS cockpit started)
# never:          npx @deepseek-ai/dsh web ...  /  a second terminal for the runtime
#
# WHAT IT STARTS (operator is UI-only -- no second terminal):
#   1. the resident harness_runtime on runs/session-main (adopt-or-spawn, below)
#   2. the EVOLUTION runtime on runs/session-robocasa-rsi (--mode evolution
#      --frames, robocasa venv, headless egl) -- ON by default: it is the inbox
#      rsi/campaign briefs land in, and leaving it un-managed is how briefs got
#      dropped into a dead inbox. Skipped with a warning if the venv is absent.
#   3. the web console (the ph-station fork build)
#
# RUNTIME adopt-vs-spawn: harness_runtime.py now guards its own session dir (an
#   exclusive flock on runs/<session>/runtime.lock; a second instance refuses to
#   start and names the holding pid, and the lock dies with the process). Cockpit's
#   `ps` scan is the FRIENDLY half of the same rule -- it adopts instead of racing,
#   so the lock only ever speaks when something bypassed cockpit. If one exists on
#   runs/session-main it is ADOPTED (its PID printed, NOT restarted,
#   NOT recorded for --stop -- cockpit did not start it, so cockpit won't kill it).
#   If none exists cockpit SPAWNS one (nohup, logged to runs/session-main/
#   runtime.log) and records its PID so --stop can kill it. --render is passed IFF
#   $DISPLAY is set (the runtime hard-refuses --render headless); headless spawns
#   get MUJOCO_GL=egl for offscreen sim. Opt out with --no-runtime / --no-render.
#
# --stop kills BOTH the web server and any runtime cockpit SPAWNED, by the exact
#   PIDs recorded in the pidfile (never pkill-by-pattern -- that would match
#   operator shells). An ADOPTED runtime is left running.
#
# HOW IT SERVES: the ph-station fork's own build. brand is NATIVE in fork source
#   (no launch-time string patching). it (1) sources nvm (node 22), (2) seeds the
#   workspace user-data record, (3) serves the console from the built fork bin.
#   (the pre-fork npx + profiles/dsh/rebrand.sh overlay retired once the fork
#   reached parity -- see docs/ph-station-design.md §6.)
#
# the harness MCP integration is loaded from $DSH_HOME/cordis.patch.yml -- there
# is NO `--patch` flag on `dsh web`. That file is RENDERED here on every start by
# profiles/dsh/deploy_profile.py from the committed template; a fresh clone
# therefore reaches a tool-equipped console with no manual copy.
set -o pipefail
set -u

DO_STOP=0
NO_RUNTIME=0
NO_RENDER=0
WITH_ROBOCASA=0                          # opt-in second runtime (design §1); OFF by default
SESSION_DIR="runs/session-main"          # cockpit's canonical resident session
ROBOCASA_SESSION_DIR="runs/session-robocasa"
EVOLUTION_SESSION_DIR="runs/session-robocasa-rsi"  # evolution runtime; ON by default

usage() {
  cat <<EOF
physical-harness cockpit -- the single entry that starts EVERYTHING

usage: cockpit [--port N] [--no-render] [--no-runtime]
       cockpit --stop
       cockpit -h|--help

  --port N       port to serve the console on (default: PH_CONSOLE_PORT from
                 the repo's .env, else 3080)
  --trusted-host H  also trust gateway requests arriving via host H (dsh binds
                 127.0.0.1 only; pair this with a LAN forward like socat when
                 the operator's browser is on another machine). Default:
                 PH_TRUSTED_HOST from the repo's .env, else unset.
  --no-render    spawn the runtime headless even with a display attached
                 (default: --render IFF \$DISPLAY is set; the runtime refuses
                 --render without a display)
  --no-runtime   do not adopt or spawn ANY runtime (execution or evolution);
                 serve only the web console (the pre-single-entry behavior)
  --with-robocasa  ALSO bring up a second runtime on $ROBOCASA_SESSION_DIR using
                 the robocasa venv interpreter (headless MUJOCO_GL=egl, cwd=repo).
                 OFF by default -- the default start touches only $SESSION_DIR and
                 never auto-spawns a second runtime. Override the interpreter with
                 ROBOCASA_PYTHON=... (default \$REPO/../sims/robocasa-venv/bin/python).
  --stop         stop the web server and any runtime THIS cockpit spawned, by the
                 exact PIDs in each session's pidfile. An ADOPTED runtime is left
                 running. Reaps every session (main + robocasa) it recorded.
  -h, --help     show this help

Before serving it renders \$DSH_HOME/cordis.patch.yml from
profiles/dsh/cordis.patch.template.yml (the console's MCP tools, LLM route and
default agent preset) and seeds the workspace record. Both are idempotent.

Starting (no --stop) brings up three things and leaves them running:
  1. the resident harness_runtime on $SESSION_DIR --
       ADOPTED if one is already serving it (PID printed, not restarted, not
       killed by --stop), otherwise SPAWNED (nohup, logged) and recorded for
       --stop. Never two runtimes on one session dir. --with-robocasa adds a
       SECOND, independently adopt-or-spawned runtime on $ROBOCASA_SESSION_DIR.
  2. the EVOLUTION runtime on $EVOLUTION_SESSION_DIR (--mode evolution --frames,
       robocasa venv, headless MUJOCO_GL=egl) -- same adopt-or-spawn discipline,
       ON by default (this inbox takes rsi/campaign briefs; an un-managed dead
       runtime here is how briefs got dropped into a dead inbox). Skipped with
       a warning when the robocasa venv is absent.
  3. the web console (the ph-station fork build).

serves the ph-station fork build (native brand). use this instead of running
'npx @deepseek-ai/dsh web' or a second terminal for the runtime.
EOF
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO="$(cd "$HERE/.." && pwd -P)"

# Defaults come from the repo root's git-ignored .env (see .env.example); a flag
# below still wins. The file is READ, never sourced -- exporting it would put
# credentials in the process environment, which outranks the console's own
# credential store and would shadow a key the Models page writes. Same parse
# rules as profiles/dsh/deploy_profile.py: comment lines and blanks skipped,
# `export ` dropped, one layer of matching quotes stripped, last assignment wins.
_env_get() {
  [ -f "$REPO/.env" ] || return 0
  local line out=""
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$1="*)          out="${line#*=}";;
      "export $1="*)   out="${line#*=}";;
      *) continue;;
    esac
  done < "$REPO/.env"
  out="${out%\"}"; out="${out#\"}"; out="${out%\'}"; out="${out#\'}"
  printf '%s' "$out"
}

PORT="$(_env_get PH_CONSOLE_PORT)"; PORT="${PORT:-3080}"
TRUSTED_HOST="$(_env_get PH_TRUSTED_HOST)"

while [ $# -gt 0 ]; do
  case "$1" in
    --port)   PORT="${2:?--port needs a value}"; shift 2;;
    --port=*) PORT="${1#*=}"; shift;;
    --trusted-host)   TRUSTED_HOST="${2:?--trusted-host needs a value}"; shift 2;;
    --trusted-host=*) TRUSTED_HOST="${1#*=}"; shift;;
    --stop)   DO_STOP=1; shift;;
    --no-runtime) NO_RUNTIME=1; shift;;
    --no-render)  NO_RENDER=1; shift;;
    --with-robocasa) WITH_ROBOCASA=1; shift;;
    -h|--help) usage; exit 0;;
    *) echo "cockpit: unknown argument: $1" >&2; usage >&2; exit 2;;
  esac
done

PH_STATION="${PH_STATION:-$HOME/Desktop/ph-station}"
# robocasa runtime interpreter: its venv is a SIBLING of the repo (see
# docs/sim-adaptation.md §0 -- numpy 1/2 ABI forces a separate venv), overridable.
ROBOCASA_PYTHON="${ROBOCASA_PYTHON:-$REPO/../sims/robocasa-venv/bin/python}"
PIDFILE="$REPO/$SESSION_DIR/cockpit.pids"
RUNTIME_LOG="$REPO/$SESSION_DIR/runtime.log"

# --- helpers ----------------------------------------------------------------
_alive()  { kill -0 "$1" 2>/dev/null; }
_cmd_of() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; }

# PID of a live harness_runtime serving the given session dir, or empty. Reads a
# `ps` snapshot and matches in-shell (no grep child to self-match); the snapshot
# only contains processes alive when ps ran, and neither `ps` nor this shell's
# own cmdline mentions harness_runtime.py, so there is no false positive.
# The trailing space appended to $rest makes "--session-dir $sess" match on a
# word BOUNDARY: without it, session-robocasa would adopt the session-robocasa-rsi
# runtime (prefix collision) and never bring its own up.
find_runtime() {
  local sess="$1" pid rest
  ps -eo pid=,args= | while read -r pid rest; do
    case "$rest " in
      *harness_runtime.py*"--session-dir $sess "*) echo "$pid"; break;;
    esac
  done
}

# Kill an EXACT recorded PID only if its cmdline still matches (guards against
# PID reuse -- we never pattern-kill).
kill_recorded() {
  local pid="$1" needle="$2" label="$3"
  if ! _alive "$pid"; then
    echo "cockpit: $label (pid $pid) already not running" >&2
    return
  fi
  case "$(_cmd_of "$pid")" in
    *"$needle"*) kill "$pid" && echo "cockpit: stopped $label (pid $pid)" >&2;;
    *) echo "cockpit: WARNING pid $pid is not $label anymore (cmdline changed); NOT killing" >&2;;
  esac
}

# adopt-or-spawn ONE session's runtime. Sets globals RT_PID/RT_ADOPTED for the
# caller to fold into that session's pidfile. Identical discipline for every
# session: adopt a live one by cmdline match (never restart, never record for
# --stop), else spawn detached and record. allow_render=1 permits the live
# MuJoCo window (session-main); a headless-only sim (robocasa) passes 0 and
# always gets MUJOCO_GL=egl. Any further args ($4...) ride the runtime cmdline
# verbatim (e.g. --mode evolution --frames for the evolution session).
runtime_up() {
  local session="$1" interp="$2" allow_render="$3"
  shift 3
  mkdir -p "$REPO/$session"
  local existing
  existing="$(find_runtime "$session")"
  if [ -n "$existing" ]; then
    RT_PID="$existing"; RT_ADOPTED=1
    echo "cockpit: adopting resident runtime on $session (pid $RT_PID); not restarting" >&2
    return
  fi
  local -a spawn_env=(PYTHONPATH="$REPO")
  local -a render_flag=()
  if [ "$allow_render" -eq 1 ] && [ "$NO_RENDER" -eq 0 ] && [ -n "${DISPLAY:-}" ]; then
    render_flag=(--render)
  else
    spawn_env+=(MUJOCO_GL=egl)   # headless: offscreen sim needs egl
  fi
  local log="$REPO/$session/runtime.log"
  # cd in a subshell so the runtime cmdline stays the canonical relative form
  # (matches find_runtime on the next boot). setsid, not just nohup: nohup only
  # blocks SIGHUP, so a runtime stayed in the launching terminal's process group
  # and a group-wide teardown (`kill -- -PGID`, an agent/CI session ending) took
  # it down mid-campaign -- 140/153 calibration episodes lost that way on
  # 2026-08-28. Its own session makes it survive whatever started it.
  RT_PID="$(cd "$REPO" && { setsid env "${spawn_env[@]}" "$interp" \
      scripts/harness_runtime.py --session-dir "$session" "${render_flag[@]}" "$@" \
      >>"$log" 2>&1 < /dev/null & echo $!; })"
  RT_ADOPTED=0
  echo "cockpit: spawned resident runtime on $session (pid $RT_PID, render=$([ ${#render_flag[@]} -gt 0 ] && echo on || echo off), log $log)" >&2
}

# Reap a runtime recorded in a pidfile: kill it by EXACT pid iff its cmdline
# still matches (never pattern-kill), or leave an adopted one running.
stop_recorded_runtime() {
  local pid="$1" adopted="$2" label="$3"
  [ -n "$pid" ] || return
  if [ "$adopted" = "0" ]; then
    kill_recorded "$pid" "harness_runtime.py" "$label"
  else
    echo "cockpit: $label pid $pid was ADOPTED (started outside cockpit); leaving it running" >&2
  fi
}

# --- --stop: read every session pidfile, kill exactly what we started -------
# The main session pidfile also carries the web pid; extra sessions (robocasa)
# carry only their runtime. Each is reaped by the SAME exact-PID + cmdline-guard
# discipline, one session at a time.
if [ "$DO_STOP" -eq 1 ]; then
  stopped_any=0
  # main session: web server + its runtime
  if [ -f "$PIDFILE" ]; then
    stopped_any=1
    web_pid=""; web_adopted="0"; runtime_pid=""; runtime_adopted="1"
    while IFS='=' read -r k v; do
      case "$k" in
        web_pid) web_pid="$v";;
        web_adopted) web_adopted="$v";;
        runtime_pid) runtime_pid="$v";;
        runtime_adopted) runtime_adopted="$v";;
      esac
    done < "$PIDFILE"
    if [ -n "$web_pid" ]; then
      if [ "$web_adopted" = "1" ]; then
        echo "cockpit: web server (pid $web_pid) was ADOPTED; leaving it up" >&2
      else
        kill_recorded "$web_pid" "web --no-open" "web server"
      fi
    fi
    stop_recorded_runtime "$runtime_pid" "$runtime_adopted" "runtime ($SESSION_DIR)"
    rm -f "$PIDFILE"
  fi
  # extra per-session runtimes (e.g. session-robocasa): each its own pidfile
  for pf in "$REPO"/runs/*/cockpit.pids; do
    [ -e "$pf" ] || continue           # no match -> glob stays literal, skip
    [ "$pf" = "$PIDFILE" ] && continue  # main already handled above
    stopped_any=1
    runtime_pid=""; runtime_adopted="1"
    while IFS='=' read -r k v; do
      case "$k" in
        runtime_pid) runtime_pid="$v";;
        runtime_adopted) runtime_adopted="$v";;
      esac
    done < "$pf"
    stop_recorded_runtime "$runtime_pid" "$runtime_adopted" "runtime ($(basename "$(dirname "$pf")"))"
    rm -f "$pf"
  done
  [ "$stopped_any" -eq 0 ] && echo "cockpit: no pidfile under $REPO/runs/*/cockpit.pids; nothing to stop" >&2
  exit 0
fi

# --- start path -------------------------------------------------------------
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "cockpit: ERROR nvm not found at $NVM_DIR/nvm.sh" >&2
  exit 1
fi
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
nvm use 22 >/dev/null

export DSH_HOME="${DSH_HOME:-$HOME/.dsh}"

# --- resident runtime: adopt-or-spawn (single entry means no second terminal)
RT_PID=""
RT_ADOPTED=""
if [ "$NO_RUNTIME" -eq 0 ]; then
  # --frames explicitly, not by the headless-GL auto-enable: a display-attached
  # spawn (render=on) leaves MUJOCO_GL unset, which used to silently switch the
  # 取景窗 OFF for a REMOTE operator -- the local window they cannot see was
  # suppressing the browser viewport they use. The two compose in _mount_plan.
  runtime_up "$SESSION_DIR" ".venv/bin/python" 1 --frames
fi

# --- web: adopt-or-spawn (same discipline as the runtime). A server already
# on $PORT (a previous cockpit, or a deploy session's live web) is ADOPTED:
# record its REAL pid so the pidfile never lies, and --stop leaves it up
# (web_adopted=1) exactly like an adopted runtime. Without this, a second
# cockpit start spawn-crashes on EADDRINUSE and records a dead web pid.
WEB_ADOPTED=0
WEB_PID=""
if curl -sf -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/"; then
  WEB_PID="$(fuser "$PORT/tcp" 2>/dev/null | awk '{print $1}')"
  WEB_ADOPTED=1
  echo "cockpit: adopting web server already on :$PORT (pid ${WEB_PID:-unknown}); not restarting" >&2
fi

# record PIDs for --stop. Spawned web_pid=$$: this shell is replaced by the web
# server via exec below, so $$ is the server's PID after exec.
{
  if [ "$WEB_ADOPTED" -eq 1 ]; then echo "web_pid=$WEB_PID"; else echo "web_pid=$$"; fi
  echo "web_adopted=$WEB_ADOPTED"
  echo "port=$PORT"
  if [ -n "$RT_PID" ]; then
    echo "runtime_pid=$RT_PID"
    echo "runtime_adopted=$RT_ADOPTED"
  fi
} > "$PIDFILE"

# --- optional second runtime: session-robocasa (design §1) ------------------
# OFF unless --with-robocasa. Its own adopt-or-spawn + own pidfile, so --stop
# reaps it independently. Never auto-started -- the robocasa card is enabled=false
# until phase 3/4, and the default start must not conjure a second runtime.
if [ "$NO_RUNTIME" -eq 0 ] && [ "$WITH_ROBOCASA" -eq 1 ]; then
  if [ ! -x "$ROBOCASA_PYTHON" ]; then
    echo "cockpit: ERROR --with-robocasa needs the robocasa venv interpreter at" >&2
    echo "cockpit:   $ROBOCASA_PYTHON (override with ROBOCASA_PYTHON=...)" >&2
    exit 1
  fi
  runtime_up "$ROBOCASA_SESSION_DIR" "$ROBOCASA_PYTHON" 0
  {
    echo "runtime_pid=$RT_PID"
    echo "runtime_adopted=$RT_ADOPTED"
  } > "$REPO/$ROBOCASA_SESSION_DIR/cockpit.pids"
fi

# --- evolution runtime: session-robocasa-rsi (annexed; ON by default) --------
# The inbox rsi/campaign briefs land in. Before this block cockpit managed only
# the execution runtime, so a dead evolution runtime went unnoticed and briefs
# rotted in its inbox. Same adopt-or-spawn + exact-PID pidfile discipline (its
# own runs/<session>/cockpit.pids, reaped by the generic --stop loop); headless
# (MUJOCO_GL=egl via allow_render=0) with --frames so the 取景窗 has a viewport.
# A missing robocasa venv warns and skips -- never blocks the console.
if [ "$NO_RUNTIME" -eq 0 ]; then
  if [ -x "$ROBOCASA_PYTHON" ]; then
    runtime_up "$EVOLUTION_SESSION_DIR" "$ROBOCASA_PYTHON" 0 --mode evolution --frames
    {
      echo "runtime_pid=$RT_PID"
      echo "runtime_adopted=$RT_ADOPTED"
    } > "$REPO/$EVOLUTION_SESSION_DIR/cockpit.pids"
  else
    echo "cockpit: WARNING robocasa venv missing at $ROBOCASA_PYTHON; evolution runtime ($EVOLUTION_SESSION_DIR) NOT started" >&2
  fi
fi

# adopted web: runtimes are up and recorded; nothing left to serve.
if [ "$WEB_ADOPTED" -eq 1 ]; then
  exit 0
fi

# --- serve the ph-station fork build -----------------------------------------
BIN="$PH_STATION/apps/cli/lib/bin.js"
DIST="$PH_STATION/apps/web/dist/index.html"
if [ ! -f "$DIST" ] || [ ! -f "$BIN" ]; then
  echo "cockpit: ERROR ph-station build missing ($DIST / $BIN)." >&2
  echo "cockpit: run 'pnpm run build' in $PH_STATION." >&2
  exit 1
fi

# A fresh clone has no runs/ -- it is gitignored evidence. board/mcp_server.py
# REFUSES to start on a missing runs dir (a deliberate typo guard), so without
# this the console comes up with the harness MCP row failing to compose and the
# agent silently toolless. The runtime path already mkdirs its own session dir;
# this covers --no-runtime and the very first start after a clone.
mkdir -p "$REPO/runs"

# render $DSH_HOME/cordis.patch.yml from the committed template. This is what
# gives the console its mcp__physical-harness__* tools, its LLM route and the
# `physical` agent preset, and dsh has no --patch flag, so the file must exist
# BEFORE the server starts. It is the one step that must never fail quietly:
# without it the agent has no harness tools at all and falls back to native
# bash -- the ungoverned path the MCP server exists to prevent.
if ! python3 "$REPO/profiles/dsh/deploy_profile.py" --repo "$REPO" --dsh-home "$DSH_HOME"; then
  echo "cockpit: ERROR could not render $DSH_HOME/cordis.patch.yml" >&2
  echo "cockpit: WITHOUT IT THE AGENT HAS NO mcp__physical-harness__* TOOLS -- it" >&2
  echo "cockpit:   falls back to native bash, the ungoverned path. Refusing to serve." >&2
  exit 1
fi

# seed the workspace user-data record (orthogonal to brand; native brand does
# not seed a workspace). MUST run before the server starts -- the server holds
# the workspace unit open and republishes the whole file on every mutation.
if ! python3 "$REPO/profiles/dsh/seed_workspace.py" --workspace "$REPO" --dsh-home "$DSH_HOME"; then
  echo "cockpit: WARNING workspace seed reported an issue; console still serves" >&2
fi

# BoardBridge box paths (the fork-only channel): the web-app bundle's
# board-bridge row reads these PH_BOARD_* env vars via !!js and disables itself
# when PH_BOARD_REPO is unset, so the 战报 panel's /api/board/* endpoints only
# come alive on this fork path. The board host package ships in the fork bundle,
# never in $DSH_HOME/cordis.patch.yml (design §3).
export PH_BOARD_PYTHON="${PH_BOARD_PYTHON:-$REPO/.venv/bin/python}"
export PH_BOARD_REPO="${PH_BOARD_REPO:-$REPO}"
export PH_BOARD_RUNS="${PH_BOARD_RUNS:-$REPO/runs}"

echo "cockpit: serving physical-harness console (fork build) at http://127.0.0.1:$PORT" >&2
# cd to the repo root FIRST: dsh's credential store falls back to `<invocation
# cwd>/.env`, so without this the keys the console can see depend on which
# directory the operator happened to type the command in.
cd "$REPO" || { echo "cockpit: ERROR cannot cd to $REPO" >&2; exit 1; }
# setsid + background, NOT exec: the console must outlive the terminal that
# started it. The runtimes already do (runtime_up spawns them with setsid), so an
# exec'd web server meant a closed terminal left the operator with live runtimes
# and a dead UI -- the one surface they actually use. Logs go to a file because a
# detached process has no terminal to write to.
WEB_LOG="$REPO/$SESSION_DIR/web.log"
setsid node "$BIN" web --no-open --port "$PORT" \
  ${TRUSTED_HOST:+--trusted-host "$TRUSTED_HOST"} >>"$WEB_LOG" 2>&1 </dev/null &
WEB_SPAWNED=$!
# The pidfile above recorded $$ on the assumption that exec would replace this
# shell with node. It no longer does, so correct the row to the pid that is
# actually serving -- --stop kills by that exact pid (with a cmdline re-check).
sed -i "s/^web_pid=.*/web_pid=$WEB_SPAWNED/" "$PIDFILE"
echo "cockpit: console detached (pid $WEB_SPAWNED, log $WEB_LOG); this terminal is free" >&2
